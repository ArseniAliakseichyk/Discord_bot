# ============================================================================
#  Discord Music Bot — example environment variables.
#  Copy to `.env` and fill in the values:  cp .env.example .env
# ============================================================================

# NOTE: this file is read both by python-dotenv and by Docker Compose
# (`env_file:`). Compose does not strip trailing `# comments` from a value, so
# never put a comment on the same line as a setting — the bot would receive
# "1200        # seconds" and fail to start with a validation error.

# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token

# Bot owner IDs, comma-separated (may use /authorize etc.).
# If empty, the application owner from the Developer Portal is used.
# A non-numeric value here is a hard startup error, not a silent fallback.
OWNER_IDS=

# Channel for logs and for storing uploaded images (optional).
LOG_CHANNEL_ID=

# Users whose actions are NOT logged (comma-separated, optional).
EXCLUDED_USER_IDS=

# --- Lavalink (required for music) ---
# In docker-compose the host is the service name `lavalink`.
# Locally use http://localhost:2333
LAVALINK_URI=http://lavalink:2333
# Change this. Compose passes the same value to the Lavalink container, so both
# sides stay in sync as long as it lives here rather than only in your shell.
LAVALINK_PASSWORD=change-me
# Path where the Lavalink container sees the ./music folder (compose mount).
LAVALINK_LOCAL_DIR=/music

# --- Spotify (optional) ---
# Enables Spotify track links and the `spsearch:` prefix.
# Get them at https://developer.spotify.com/dashboard -> Create App.
# The Redirect URI the dashboard asks for is NOT used: LavaSrc authenticates
# with the client-credentials flow, which never redirects. Put anything valid
# there (e.g. http://127.0.0.1:8888/callback) and ignore it afterwards.
# Spotify supplies metadata only; audio is mirrored from YouTube by ISRC.
# Works: single track links and `spsearch:` queries.
# Does NOT work: Spotify album and playlist links — Spotify closed those
# endpoints to bots in its February 2026 Web API migration. Use YouTube
# playlists for bulk queueing. See the README for the measured details.
# Leave both empty to run without Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube playback ---
# Signing in is the equivalent of the cookies.txt the old yt-dlp bot used, and
# the reason that one played everything. Without it YouTube hands out
# SABR-only responses for a share of videos, which carry no stream URL at all.
#   1) YOUTUBE_OAUTH=true, then `docker compose up -d --force-recreate lavalink`
#   2) `docker compose logs lavalink | grep OAUTH` -> open google.com/device and
#      enter the code, using a BURNER account (it can get terminated)
#   3) the log then prints a refresh token; paste it below so step 2 never
#      repeats
YOUTUBE_OAUTH=
YOUTUBE_REFRESH_TOKEN=

# Proof-of-origin token: the no-account alternative to signing in, since
# nothing is authorised there is no account to lose. Note it did NOT fix
# SABR-only videos in testing — see the README. Generate with:
#   docker run --name bgutil-provider -d --init \
#     -p 127.0.0.1:4416:4416 brainicism/bgutil-ytdlp-pot-provider
#   curl -s -X POST http://127.0.0.1:4416/get_pot -d '{}' \
#     -H 'Content-Type: application/json'
# poToken -> TOKEN, contentBinding -> VISITOR_DATA. Both expire; regenerate
# when playback degrades. (The generator the plugin's README names is
# deprecated and no longer works.)
YOUTUBE_POT_TOKEN=
YOUTUBE_POT_VISITOR_DATA=

# Set to DEBUG to see why a track produced no stream.
YOUTUBE_LOG_LEVEL=

# Stream signatures are deciphered by the yt-cipher service in docker-compose,
# because youtube-source no longer does it itself. Without it, search works but
# every track fails with "No supported audio streams available".
# Leave empty to use the bundled container; set to https://cipher.kikkia.dev/
# to use the author's public instance instead.
YT_CIPHER_URL=
YT_CIPHER_PASSWORD=

# Only needed if a plugin release stops being able to fetch streams. Pick a
# commit from https://github.com/lavalink-devs/youtube-source and set:
#   YOUTUBE_PLUGIN_VERSION=<commit sha>
#   YOUTUBE_PLUGIN_REPO=snapshots
#   YOUTUBE_PLUGIN_SNAPSHOT=true
YOUTUBE_PLUGIN_VERSION=
YOUTUBE_PLUGIN_REPO=
YOUTUBE_PLUGIN_SNAPSHOT=

# --- Announcements / roles ---
# Role IDs (comma-separated) allowed to use /announce, /constructor, /jointo.
ALLOWED_ROLES=
# Default announcements channel.
DEFAULT_CHANNEL=

# --- Music ---
MUSIC_FOLDER=./music
# Max track length in seconds; 0 disables the limit.
MAX_TRACK_LENGTH=1200
# Max tracks added from a single playlist.
MAX_PLAYLIST_TRACKS=100
# Default volume, 0..200.
DEFAULT_VOLUME=100
# Auto-leave after this many seconds of inactivity.
INACTIVE_TIMEOUT=300

# --- Storage ---
DATABASE_PATH=./data/bot.db
